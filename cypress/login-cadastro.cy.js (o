describe('QA Suite - Cadastro e Autenticação de Usuário', () => {
  // Geramos um email dinâmico com timestamp para garantir que cada execução tenha um usuário novo
  const emailNovo = `qa.test.${Date.now()}@mailinator.com`;
  const nomeUsuario = 'Testadora QA';

  beforeEach(() => {
    // Visita a tela de Signup / Login antes de cada cenário
    cy.visit('https://automationexercise.com/login');
  });

  it('CT01 - Deve realizar o cadastro de um novo usuário com sucesso (Caminho Feliz)', () => {
    // 1. Preenche o formulário inicial de cadastro
    cy.get('[data-qa="signup-name"]').type(nomeUsuario);
    cy.get('[data-qa="signup-email"]').type(emailNovo);
    cy.get('[data-qa="signup-button"]').click();

    // 2. Preenche os detalhes da conta (campos obrigatórios)
    cy.get('#id_gender2').check(); // Seleciona gênero (Mrs.)
    cy.get('[data-qa="password"]').type('SenhaSegura123!');
    
    // Data de nascimento
    cy.get('[data-qa="days"]').select('15');
    cy.get('[data-qa="months"]').select('January');
    cy.get('[data-qa="years"]').select('1990');

    // Informações do endereço
    cy.get('[data-qa="first_name"]').type('Liliane');
    cy.get('[data-qa="last_name"]').type('QA');
    cy.get('[data-qa="address"]').type('Rua dos Testes, 123');
    cy.get('[data-qa="country"]').type('United States');
    cy.get('[data-qa="state"]').type('São Paulo');
    cy.get('[data-qa="city"]').type('Mauá');
    cy.get('[data-qa="zipcode"]').type('09000000');
    cy.get('[data-qa="mobile_number"]').type('11999999999');

    // 3. Submete o formulário
    cy.get('[data-qa="create-account"]').click();

    // 4. Valida se a conta foi criada
    cy.get('[data-qa="account-created"]').should('be.visible');
    cy.contains('Account Created!').should('be.visible');
  });

  it('CT02 - [Exceção] Não deve permitir cadastro com e-mail já existente', () => {
    // Tenta cadastrar usando um e-mail fixo que já existe no sistema
    cy.get('[data-qa="signup-name"]').type('Usuário Duplicado');
    cy.get('[data-qa="signup-email"]').type('email.existente@test.com');
    cy.get('[data-qa="signup-button"]').click();

    // Valida a mensagem de erro da API/Front-end
    cy.contains('Email Address already exist!').should('be.visible');
  });

  it('CT03 - [Exceção] Não deve permitir login com credenciais inválidas', () => {
    // Tenta logar com e-mail e senha errados
    cy.get('[data-qa="login-email"]').type('usuario.inexistente@test.com');
    cy.get('[data-qa="login-password"]').type('senhaErrada123');
    cy.get('[data-qa="login-button"]').click();

    // Valida a mensagem de erro
    cy.contains('Your email or password is incorrect!').should('be.visible');
  });
});